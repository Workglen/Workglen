[Unit]
Description=Workglen Mail Rust mail server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=workglen
Group=workglen
UMask=0077
StateDirectory=workglen
ConfigurationDirectory=workglen
ExecStart=/usr/local/bin/workglen serve /etc/workglen/node.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
LimitNOFILE=256
TasksMax=96
MemoryHigh=384M
MemoryMax=480M
MemorySwapMax=0
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
