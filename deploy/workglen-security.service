[Unit]
Description=Workglen native Mail Security
After=network-online.target
Wants=network-online.target

[Service]
User=workglen-security
Group=workglen-security
ExecStart=/usr/local/bin/workglen security-serve /etc/workglen-security/config.json
Restart=on-failure
RestartSec=5
UMask=0077
LimitCORE=0
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/workglen-security
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
