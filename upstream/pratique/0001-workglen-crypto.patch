+/// Streaming SHA-1 for bounded-memory legacy protocol interoperability.
+#[derive(Clone)]
+pub struct Sha1 {
+    state: [u32; 5],
+    buffer: [u8; 64],
+    used: usize,
+    length: u64,
+}
+
+impl Default for Sha1 {
+    fn default() -> Self { Self::new() }
+}
+
+impl Sha1 {
+    pub fn new() -> Self {
+        Self { state: [0x6745_2301, 0xefcd_ab89, 0x98ba_dcfe, 0x1032_5476, 0xc3d2_e1f0],
+            buffer: [0; 64], used: 0, length: 0 }
+    }
+
+    pub fn update(&mut self, mut bytes: &[u8]) {
+        self.length = self.length.wrapping_add(bytes.len() as u64);
+        if self.used != 0 {
+            let take = (64 - self.used).min(bytes.len());
+            self.buffer[self.used..self.used + take].copy_from_slice(&bytes[..take]);
+            self.used += take;
+            bytes = &bytes[take..];
+            if self.used != 64 { return; }
+            compress(&mut self.state, &self.buffer);
+            self.used = 0;
+        }
+        let mut chunks = bytes.chunks_exact(64);
+        for block in &mut chunks { compress(&mut self.state, block.try_into().unwrap()); }
+        let rest = chunks.remainder();
+        self.buffer[..rest.len()].copy_from_slice(rest);
+        self.used = rest.len();
+    }
+
+    pub fn finalize(mut self) -> [u8; 20] {
+        let mut tail = [0; 128];
+        tail[..self.used].copy_from_slice(&self.buffer[..self.used]);
+        tail[self.used] = 0x80;
+        let total = if self.used < 56 { 64 } else { 128 };
+        tail[total - 8..total].copy_from_slice(&self.length.wrapping_mul(8).to_be_bytes());
+        for block in tail[..total].chunks_exact(64) { compress(&mut self.state, block.try_into().unwrap()); }
+        let mut out = [0; 20];
+        for (dst, word) in out.chunks_exact_mut(4).zip(self.state) { dst.copy_from_slice(&word.to_be_bytes()); }
+        out
+    }
+}
 
